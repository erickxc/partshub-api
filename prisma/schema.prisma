generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("starter")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  products        Product[]
  vehicles        Vehicle[]
  productVehicles ProductVehicle[]
  stocks          Stock[]
  stockMovements  StockMovement[]
  customers       Customer[]
  sales           Sale[]
  saleItems       SaleItem[]
  salePayments    SalePayment[]
  budgets         Budget[]
  budgetItems     BudgetItem[]
  cashRegisters   CashRegister[]
}

model User {
  id           String   @id @default(uuid())
  email        String
  passwordHash String
  name         String
  role         String   @default("operator")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([email, tenantId])
  @@index([tenantId])
}

model Product {
  id               String   @id @default(uuid())
  name             String
  brand            String?
  category         String?
  internalCode     String?
  manufacturerCode String?
  price            Decimal  @db.Decimal(10, 2)
  cost             Decimal? @db.Decimal(10, 2)
  unit             String   @default("un")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productVehicles ProductVehicle[]
  stock           Stock?
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  budgetItems     BudgetItem[]

  @@index([tenantId])
  @@index([tenantId, internalCode])
  @@index([tenantId, category])
}

model Vehicle {
  id     String  @id @default(uuid())
  brand  String
  model  String
  year   Int
  engine String?
  active Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productVehicles ProductVehicle[]

  @@index([tenantId])
  @@index([tenantId, brand])
}

model ProductVehicle {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([productId, vehicleId, tenantId])
  @@index([tenantId])
}

model Stock {
  id          String   @id @default(uuid())
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  updatedAt   DateTime @updatedAt

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model StockMovement {
  id        String   @id @default(uuid())
  type      String
  quantity  Int
  reason    String?
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  saleId String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, productId])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  document  String?
  phone     String?
  email     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  sales   Sale[]
  budgets Budget[]

  @@index([tenantId])
}

model Sale {
  id        String   @id @default(uuid())
  number    Int      @default(0)
  total     Decimal  @db.Decimal(10, 2)
  discount  Decimal  @default(0) @db.Decimal(10, 2)
  status    String   @default("completed")
  notes     String?
  createdAt DateTime @default(now())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  items    SaleItem[]
  payments SalePayment[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, number])
}

model SaleItem {
  id       String  @id @default(uuid())
  quantity Int
  price    Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model SalePayment {
  id     String  @id @default(uuid())
  method String
  amount Decimal @db.Decimal(10, 2)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Budget {
  id         String    @id @default(uuid())
  number     Int       @default(0)
  status     String    @default("draft")
  validUntil DateTime?
  notes      String?
  discount   Decimal   @default(0) @db.Decimal(10, 2)
  total      Decimal   @default(0) @db.Decimal(10, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  convertedSaleId String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  items BudgetItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, number])
}

model CashRegister {
  id              String    @id @default(uuid())
  status          String    @default("closed")
  openedAt        DateTime?
  closedAt        DateTime?
  openingBalance  Decimal   @default(0) @db.Decimal(10, 2)
  closingBalance  Decimal   @default(0) @db.Decimal(10, 2)
  expectedBalance Decimal   @default(0) @db.Decimal(10, 2)
  difference      Decimal?  @db.Decimal(10, 2)
  notes           String?
  openedById      String?
  closedById      String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
}

model BudgetItem {
  id       String  @id @default(uuid())
  quantity Int
  price    Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}
